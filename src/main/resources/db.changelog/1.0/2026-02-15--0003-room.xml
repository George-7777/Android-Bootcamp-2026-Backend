<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="2026-02-15--0003-room" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="room"/>
            </not>
        </preConditions>
        <createTable tableName="room">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="human_count" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addColumn tableName="booking">
            <column name="room_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_booking_room" referencedTableName="room"
                             referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>